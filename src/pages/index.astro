---
import { projects } from '../data/projects'
import '../styles/global.css'

const tags = [...new Set(projects.flatMap(project => project.tags))].sort()
const description =
  "Explore Ekansh Jain's apps, open-source packages, and developer tools."
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content="Ekansh Jain | Projects" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ejekanshjain.github.io/" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://ejekanshjain.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Ekansh Jain | Projects</title>
    <script is:inline>
      // Apply your saved preference before the page paints.
      try {
        const theme = localStorage.getItem('theme')
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#projects">
      Skip to Projects
    </a>
    <div class="mx-auto max-w-3xl px-6 sm:px-8">
      <header class="flex items-center justify-between py-8 sm:py-10">
        <a class="wordmark" href="/" aria-label="Ekansh Jain, home">
          ej.
        </a>
        <nav class="flex items-center gap-5" aria-label="Personal Links">
          <a
            class="quiet-link"
            href="https://github.com/ejekanshjain"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          <a
            class="quiet-link"
            href="https://linkedin.com/in/ejekanshjain"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
          <a
            class="quiet-link"
            href="https://x.com/ejekanshjain"
            target="_blank"
            rel="noopener noreferrer"
          >
            X
          </a>
          <button
            id="theme-toggle"
            class="icon-button"
            type="button"
            aria-label="Switch to Dark Mode"
            aria-keyshortcuts="d"
            title="Switch to Dark Mode (D)"
            hidden
          >
            <svg
              class="moon-icon"
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.9 13.1A9 9 0 0 1 10.9 3.1 9 9 0 1 0 20.9 13.1Z" />
            </svg>
            <svg
              class="sun-icon"
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
            </svg>
          </button>
        </nav>
      </header>

      <main>
        <section class="intro" aria-labelledby="intro-title">
          <h1 id="intro-title">Ekansh Jain</h1>
          <p class="intro-role">Full-stack &amp; AI engineer.</p>
          <p class="intro-description">
            I build apps and tools that solve problems.
            <br class="hidden sm:block" /> Here are the projects I share with
            you.
          </p>
        </section>

        <section
          id="projects"
          class="project-section"
          aria-labelledby="projects-title"
        >
          <div class="flex items-baseline justify-between gap-4">
            <h2 id="projects-title">Projects</h2>
            <p
              id="result-count"
              class="result-count"
              role="status"
              aria-live="polite"
              aria-atomic="true"
            >
              {projects.length} projects
            </p>
          </div>

          <form id="project-controls" class="controls" role="search" hidden>
            <div class="search-field">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="10.5" cy="10.5" r="6.5" />
                <path d="m16 16 4 4" />
              </svg>
              <label class="sr-only" for="search">
                Search Projects
              </label>
              <input
                id="search"
                name="search"
                type="search"
                placeholder="Search projects…"
                autocomplete="off"
              />
            </div>
            <label class="sr-only" for="tag-filter">
              Filter by Tag
            </label>
            <select id="tag-filter" name="tag">
              <option value="">All Tags</option>
              {tags.map(tag => (
                <option value={tag}>{tag}</option>
              ))}
            </select>
          </form>

          <ul class="project-list" aria-label="Project List">
            {projects.map(project => (
              <li
                data-project
                data-search={`${project.name} ${project.description} ${project.tags.join(' ')}`.toLowerCase()}
                data-tags={JSON.stringify(project.tags)}
              >
                <article class="project-row">
                  <div class="project-content">
                    <div class="project-heading">
                      <h3>
                        <a
                          class="project-name"
                          href={project.repository ?? project.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {project.name}
                        </a>
                      </h3>
                      {!project.openSource && (
                        <span class="source-badge">Closed Source</span>
                      )}
                      {project.fork && (
                        <span class="source-badge">Maintained Fork</span>
                      )}
                    </div>
                    <p class="project-description">{project.description}</p>
                    <ul class="tags" aria-label={`${project.name} tags`}>
                      {project.tags.map(tag => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="project-links">
                    {project.repository && (
                      <a
                        href={project.repository}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${project.name} on GitHub`}
                      >
                        GitHub
                        <svg
                          width="12"
                          height="12"
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          aria-hidden="true"
                        >
                          <path d="M4 12 12 4M4 4h8v8" />
                        </svg>
                      </a>
                    )}
                    {project.demo && (
                      <a
                        href={project.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Visit ${project.name}`}
                      >
                        Live Site
                        <svg
                          width="12"
                          height="12"
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          aria-hidden="true"
                        >
                          <path d="M4 12 12 4M4 4h8v8" />
                        </svg>
                      </a>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ul>
          <div id="empty-state" class="empty-state" hidden>
            <h3>No Projects Found</h3>
            <p>Try another search or reset your filters.</p>
            <button id="reset-filters" class="reset-button" type="button">
              Reset Filters
            </button>
          </div>
        </section>
      </main>
      <footer class="footer flex flex-wrap items-center justify-between gap-4">
        <span>Built by Ekansh Jain</span>
        <a
          class="quiet-link"
          href="https://github.com/ejekanshjain/ejekanshjain.github.io"
          target="_blank"
          rel="noopener noreferrer"
        >
          Website Source
        </a>
      </footer>
    </div>
    <script>
      import '../scripts/directory'
    </script>
  </body>
</html>
